{
    "name": "detain/phlix-plugin-phantom-mint-theme",
    "description": "Phantom Mint — a deep-sea mint UI theme for Phlix",
    "type": "phlix-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "detain/phlix-shared": "^0.21",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Phlix\\PhantomMint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlix\\PhantomMint\\": ["src/", "dev-stubs/"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
