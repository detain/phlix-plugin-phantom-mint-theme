{
    "name": "detain/phlix-plugin-phantom-mint-theme",
    "type": "phlix-plugin",
    "description": "Phantom Mint — a deep-sea mint UI theme for Phlix",
    "license": "MIT",
    "keywords": ["phlix", "phlix-plugin", "ui-theme", "theme", "phantom-mint", "mint"],
    "homepage": "https://github.com/detain/phlix-plugin-phantom-mint-theme",
    "require": {
        "php": ">=8.3",
        "detain/phlix-shared": "^0.21",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/detain/phlix-shared.git" }
    ],
    "autoload": {
        "psr-4": {
            "Phlix\\PhantomMint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlix\\PhantomMint\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "phpcs": "vendor/bin/phpcs --standard=phpcs.xml"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
